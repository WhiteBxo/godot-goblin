	"dialogues": {
		"day1.shop_opening": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "主角·内心",
					"text": "我是一个没什么本事、手头拮据的普通人，",
					"next": "line_2"
				},
				"line_2": {
					"speaker": "主角·内心",
					"text": "被快招公司坑了之后背上债务，开了一家生意惨淡的奶茶店。",
					"next": "line_3"
				},
				"line_3": {
					"speaker": "主角·内心",
					"text": "我想赚钱买房买车、孝敬父母、解决人生大事，",
					"next": "line_4"
				},
				"line_4": {
					"speaker": "主角·内心",
					"text": "但眼下最现实的目标就是别让店倒闭。",
					"next": "line_5"
				},
				"line_5": {
					"speaker": "主角·内心",
					"text": "店里已经连续几天没什么客人啊。"
				}
			}
		},
		"day1.first_human_customer": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "顾客",
					"text": "你好，我要一杯普通奶茶。"
				}
			}
		},
		"day1.shop_quiet_again": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "主角·内心",
					"text": "再这么下去，别说买房买车了，我连下个月的房租都要交不起了。当初到底是哪个天才跟我说开奶茶店稳赚不赔的？"
				}
			}
		},
		"day1.goblin_first_customer": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "主角·内心",
					"text": "……哥布林？我这是穷疯了，开始出现幻觉了？"
				}
			}
		},
		"day1.goblin_coin_reaction": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "系统",
					"text": "获得古怪金币一枚！金币上印着某种兽类。",
					"next": "line_2"
				},
				"line_2": {
					"speaker": "主角·内心",
					"text": "不是，哥们儿，你们搞角色扮演，还真拿游戏币买东西啊？",
					"next": "line_3"
				},
				"line_3": {
					"speaker": "主角",
					"text": "卧槽……你还真就只给我个游戏币？我一杯奶茶就这么没了？！",
					"portrait": "res://assets/characters/apron_man/player_neutral_portrait.png"
				}
			}
		},
		"day1.goblin_group_customers": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "哥布林甲",
					"text": "妈的，又输光了！就差最后一把，差点就能翻本了！",
					"next": "line_2"
				},
				"line_2": {
					"speaker": "哥布林乙",
					"text": "得了吧你！长老不是说了吗，金币是格里芬赐予勤劳者的恩惠。你天天往赌场里送，算什么虔诚？",
					"next": "line_3"
				},
				"line_3": {
					"speaker": "哥布林甲",
					"text": "少来！等下次格里芬降下恩赐，我肯定能赚回来！",
					"next": "line_4"
				},
				"line_4": {
					"speaker": "哥布林丙",
					"text": "哈哈哈哈！你还是先把这个月的贡品凑齐吧，小心长老又把你记下来！",
					"next": "line_5"
				},
				"line_5": {
					"speaker": "哥布林顾客",
					"text": "老板，这个是什么？给我来一杯！",
					"next": "line_6"
				},
				"line_6": {
					"speaker": "另一名哥布林",
					"text": "我也要！听说长老最近要举行新的仪式，说不定又能得到格里芬之血呢！"
				}
			}
		},
		"day1.chronicle_unlocked": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "主角·内心",
					"text": "……赌场、格里芬、长老，还有什么血？你们这角色扮演的设定还挺全啊？！",
					"next": "line_2"
				},
				"line_2": {
					"speaker": "系统",
					"text": "解锁『异世界见闻录』功能。"
				}
			}
		},
		"day1.coins_raise_suspicion": {
			"start": "line_1",
			"lines": {
				"line_1": {
					"speaker": "主角·内心",
					"text": "……不是，你们还真都用这个付账啊？",
					"next": "line_2"
				},
				"line_2": {
					"speaker": "主角·内心",
					"text": "等会儿。要不先查查这玩意儿到底值多少钱？万一真是什么收藏品呢？",
					"portrait": "res://assets/characters/apron_man/player_bad_laugh.png"
				}
			}
		}
	},
