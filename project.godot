[input_devices]

; Long-press is the touch HUD's own gesture; letting Android map it to a right
; click made holding the interact button fire a context action as well.
pointing/android/enable_long_press_as_right_click=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
; 与房间底板同色：16:9 窗口不是整数倍时四周会留边，用底色而不是纯黑，
; 视觉上是「画面居中」而不是「画面没铺满」。
environment/defaults/default_clear_color=Color(0.572, 0.486, 0.392, 1)
2d/snap/snap_2d_transforms_to_pixel=true
