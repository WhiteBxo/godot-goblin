; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="我的奶茶店连通异世界"
config/version="0.1.0"
run/main_scene="res://src/UI/title/title_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/app_icon/app_icon.png"
config/windows_native_icon="res://assets/ui/app_icon/app_icon.ico"

[autoload]

DisplayScaling="*res://src/core/display/display_scaling.gd"
GameState="*res://src/core/game_state.gd"
DevLog="*res://src/debug/developer_tools/debug_log.gd"
MCPRuntimeProbe="*uid://bsg12huaf1u5i"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
; DisplayScaling 按真实窗口计算整数倍率与逻辑视野，768p / 900p 等尺寸充分利用
; 额外空间；不足 2 倍的小窗口保留设计布局，优先构图与界面可读性。
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
; SCREEN_SENSOR_LANDSCAPE: either landscape direction, never portrait.
window/handheld/orientation=4

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/godot_mcp/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

