[gd_scene load_steps=2 format=3]
[ext_resource type="Theme" path="res://src/resources/ui/game_theme.tres" id="theme"]

[node name="ChapterRecapPage" type="VBoxContainer"]
layout_mode = 2
theme = ExtResource("theme")

[node name="Summary" type="RichTextLabel" parent="."]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
fit_content = true
scroll_active = false
theme_override_constants/line_separation = 0
text = ""

[node name="Next" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"Hint"
text = "前两天主线到此结束。本版没有第三天及以后的内容；未了结的委托记为待续。"
