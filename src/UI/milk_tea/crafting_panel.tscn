[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/UI/milk_tea/crafting_panel.gd" id="script"]
[ext_resource type="Theme" path="res://src/resources/ui/game_theme.tres" id="theme"]

[node name="CraftingPanel" type="VBoxContainer"]
size_flags_vertical = 3
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Left" type="VBoxContainer" parent="Body"]
custom_minimum_size = Vector2(216, 0)
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 8

[node name="MaterialList" type="ItemList" parent="Body/Left"]
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true
same_column_width = true
fixed_icon_size = Vector2i(16, 16)

[node name="ProductDetail" type="Label" parent="Body/Left"]
custom_minimum_size = Vector2(216, 30)
layout_mode = 2
theme_type_variation = &"Hint"
text = "选中成品可查看详情并重做"
autowrap_mode = 2

[node name="RedoButton" type="Button" parent="Body/Left"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
theme_type_variation = &"GhostButton"
disabled = true
text = "一键重做"

[node name="Right" type="VBoxContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="RecipeTitle" type="Label" parent="Body/Right"]
layout_mode = 2
theme_type_variation = &"H2"
text = "配方 · 点击自动填料"

[node name="RecipeList" type="ItemList" parent="Body/Right"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_vertical = 3
allow_reselect = true

[node name="OrderLine" type="Label" parent="Body/Right"]
layout_mode = 2
theme_type_variation = &"Hint"
autowrap_mode = 2

[node name="SelectedHeader" type="HBoxContainer" parent="Body/Right"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SelectedTitle" type="Label" parent="Body/Right/SelectedHeader"]
layout_mode = 2
size_flags_horizontal = 3
text = "已选材料"

[node name="ClearButton" type="Button" parent="Body/Right/SelectedHeader"]
custom_minimum_size = Vector2(48, 20)
layout_mode = 2
theme_type_variation = &"GhostButton"
disabled = true
