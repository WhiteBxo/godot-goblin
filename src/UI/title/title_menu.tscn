[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/UI/title/title_menu.gd" id="script"]
[ext_resource type="Theme" path="res://src/resources/ui/game_theme.tres" id="theme"]
[ext_resource type="Script" path="res://src/UI/title/title_music.gd" id="music_script"]
[ext_resource type="AudioStream" path="res://assets/audio/music/start.ogg" id="music"]

[node name="TitleMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="TitleMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("music")
volume_db = -80.0
bus = &"Music"
script = ExtResource("music_script")

[node name="ReplayTimer" type="Timer" parent="TitleMusic"]
wait_time = 15.0
one_shot = true
ignore_time_scale = true

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
color = Color(0.055, 0.035, 0.025, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(288, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="Content" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Godot Goblin"
horizontal_alignment = 1

[node name="NewGame" type="Button" parent="Center/Panel/Margin/Content"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "新游戏"

[node name="Quit" type="Button" parent="Center/Panel/Margin/Content"]
metadata/ui_press_sound = "ui.cancel"
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
text = "退出游戏"

[node name="Error" type="Label" parent="Center/Panel/Margin/Content"]
visible = false
layout_mode = 2
custom_minimum_size = Vector2(240, 0)
text = ""
horizontal_alignment = 1
autowrap_mode = 2
