[node name="Coins" parent="InteractionPoints" unique_id=386984943 instance=ExtResource("27_nv10f")]
position = Vector2(740, 1065)
interaction_id = &"coins"
display_name = "查看散落的金币"
description = "地上的硬币与手中的金币相似，颜色暗沉、沾满污渍，上面刻着一种陌生的怪物。"

[node name="EmptyLane" parent="InteractionPoints" unique_id=727965538 instance=ExtResource("27_nv10f")]
position = Vector2(1250, 625)
interaction_id = &"empty_lane"
display_name = "观察空荡的街道"
description = "四周没有行人，只有远处传来的模糊说话声和脚步声。主角犹豫了一下，最终决定不再往远处走。"

[node name="DarkExit" parent="InteractionPoints" unique_id=139378418 instance=ExtResource("27_nv10f")]
position = Vector2(1390, 300)
interaction_id = &"dark_exit"
display_name = "观察昏暗的岔路"
description = "前方光线逐渐消失，深处传来不明声响。

“黑灯瞎火的，谁知道里面有什么？不去。”"
