{
  "version": 1,
  "dialogues": {
    "day1.s03.coin_inspect": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角·内心",
          "text": "这什么破玩意儿……该不会真有人拿假币买奶茶吧？",
          "next": ""
        }
      }
    },
    "day1.s03.street_gone": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角·内心",
          "text": "……我店门口什么时候变成这样了？",
          "next": ""
        }
      }
    },
    "day1.s03.limited_exploration": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角·内心",
          "text": "黑灯瞎火的，谁知道里面有什么？不去。",
          "next": ""
        }
      }
    },
    "day1.s03.back_to_door": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角·内心",
          "text": "……完了，我这店不会真穿越了吧？",
          "next": ""
        }
      }
    },
    "day1.s04.fat_goblin_arrives": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "胖哥布林",
          "text": "日安！愿格里芬垂顾你！你就是新的格里芬使者吧？你们家卖什么的？",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "胖哥布林",
          "text": "哎呀，我可算等到了！我们哥布林洞窟的食物，我都快吃腻了！每次就盼着你们格里芬使者来，能吃到点新鲜玩意儿！",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "胖哥布林",
          "text": "哈哈哈，虽然我不挑食，但是也不能啥都吃呀！大家都叫我胖哥布林，就是因为我太爱吃了。不过嘛，胖一点又怎么了？能吃是福啊！",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "主角·内心",
          "text": "……这家伙话也太多了。",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "主角·内心",
          "text": "不过，他好像知道不少东西。或许可以趁机问问这里的情况。",
          "next": "line_6"
        },
        "line_6": {
          "speaker": "主角",
          "text": "格里芬使者……是什么？",
          "next": "line_7"
        },
        "line_7": {
          "speaker": "胖哥布林",
          "text": "啊？你不知道？",
          "next": "line_8"
        },
        "line_8": {
          "speaker": "胖哥布林",
          "text": "你难道不是被伟大的格里芬派来，为我们哥布林洞窟播撒来自黄金乡的食粮吗？",
          "next": "line_9"
        },
        "line_9": {
          "speaker": "主角·内心",
          "text": "这家伙在说什么？为什么突然用词这么装？格里芬我倒是有印象，刚刚那几个哥布林也这么说，还提到什么长老……",
          "next": "line_10"
        },
        "line_10": {
          "speaker": "主角·内心",
          "text": "不行，刚到这个地方，还不知道周围是什么情况，不能随便暴露自己的底细。先顺着他的话说吧。",
          "next": "line_11"
        },
        "line_11": {
          "speaker": "主角",
          "text": "我这不是刚来嘛，还人生地不熟的。先做点生意，慢慢熟悉这里。",
          "next": "line_12"
        },
        "line_12": {
          "speaker": "主角",
          "text": "我们店里卖的是奶茶，可是好东西。你要不要尝尝？先看看菜单。",
          "next": "line_13"
        },
        "line_13": {
          "speaker": "胖哥布林",
          "text": "哟！还真有不少花样啊！你们格里芬使者带来的东西就是新鲜！",
          "next": "line_14"
        },
        "line_14": {
          "speaker": "胖哥布林",
          "text": "我们这边也有那什么奶茶……是叫这个名儿吧？不过可没有你们这么多花样！",
          "next": "line_15"
        },
        "line_15": {
          "speaker": "胖哥布林",
          "text": "让我看看啊……经典珍珠奶茶，3G一杯。",
          "next": "line_16"
        },
        "line_16": {
          "speaker": "胖哥布林",
          "text": "嘶……是不便宜啊。不过，难得有新东西嘛！",
          "next": "line_17"
        },
        "line_17": {
          "speaker": "主角·内心",
          "text": "这些哥布林居然这么自然地接受了我的长相和这家店，甚至连价目表都能直接看懂。",
          "next": "line_18"
        },
        "line_18": {
          "speaker": "主角·内心",
          "text": "看来，这个世界的文字至少和我原来认识的文字有相通之处，物价好像也没有太大的变动……至于他们为什么把我当成什么格里芬使者，恐怕得再打听打听。",
          "next": "line_19"
        },
        "line_19": {
          "speaker": "主角·内心",
          "text": "不过现在还不能急着问，先别引起他的怀疑。",
          "next": "line_20"
        },
        "line_20": {
          "speaker": "主角",
          "text": "都是你没尝过的口味。既然难得来一趟，不如挑一杯试试？",
          "next": "line_21"
        },
        "line_21": {
          "speaker": "胖哥布林",
          "text": "哈哈哈！你说得对！那我可得好好尝尝！",
          "next": "line_22"
        },
        "line_22": {
          "speaker": "胖哥布林",
          "text": "就这个吧！看着就不错！",
          "next": "line_23"
        },
        "line_23": {
          "speaker": "胖哥布林",
          "text": "哎，这个是什么？那个又是什么？都放进去就行了吗？",
          "next": "line_24"
        },
        "line_24": {
          "speaker": "主角",
          "text": "……你先等着，做好了就给你。",
          "next": "line_25"
        },
        "line_25": {
          "speaker": "胖哥布林",
          "text": "好好好！我不催，我不催！",
          "next": ""
        }
      }
    },
    "day1.s04.first_taste": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "胖哥布林",
          "text": "嚯——！虽然贵了点，不过好吃啊！下次我还来！",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "主角·内心",
          "text": "嘴上嫌贵，喝起来倒是一点也不含糊。"
        }
      }
    },
    "day1.s04.griffin_faith": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "胖哥布林",
          "text": "说起来，你怎么一直问我格里芬啊？你真不知道？",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "主角",
          "text": "我都说了我刚来，还有很多事情不清楚。你就给我讲讲呗。",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "胖哥布林",
          "text": "啊？你真不知道啊？那你看看金币！一枚值10G，这上面不就有伟大的格里芬吗？",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "主角·内心",
          "text": "啊？这玩意真的是金币？？难道我要赚翻了？！",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "主角",
          "text": "啊，我知道，我知道！确实很伟大啊。",
          "next": "line_6"
        },
        "line_6": {
          "speaker": "主角·内心",
          "text": "呼……差点露馅。幸好穿越之前看过几本异世界轻小说。格里芬……听起来和地球上的狮鹫差不多嘛，鹰头、狮身，还长着翅膀。别说，还有点帅。",
          "next": "line_7"
        },
        "line_7": {
          "speaker": "胖哥布林",
          "text": "嘿嘿！那当然！伟大的格里芬啊！我们都敬畏它！",
          "next": "line_8"
        },
        "line_8": {
          "speaker": "胖哥布林",
          "text": "长老是最懂格里芬的人，负责主持仪式、传达它的意志。长老说，偶尔来的行脚商都是格里芬派来的使者，他们带来的稀奇商品，就是对勤劳守规矩的哥布林的赏赐！",
          "next": "line_9"
        },
        "line_9": {
          "speaker": "主角·内心",
          "text": "格里芬到底是真实存在的，还是只是传说？不过，确实有个长老一直在传达所谓的格里芬的意志。",
          "next": "line_10"
        },
        "line_10": {
          "speaker": "主角·内心",
          "text": "而且这些哥布林似乎既害怕它，又尊敬它……倒是有意思。",
          "next": "line_11"
        },
        "line_11": {
          "speaker": "主角",
          "text": "你刚才说，格里芬会惩罚不守规矩的哥布林？怎么个惩罚法？",
          "next": "line_12"
        },
        "line_12": {
          "speaker": "胖哥布林",
          "text": "嘘！这种事可不能随便乱说！",
          "next": "line_13"
        },
        "line_13": {
          "speaker": "主角",
          "text": "……不是你自己说的吗？",
          "next": "line_14"
        },
        "line_14": {
          "speaker": "胖哥布林",
          "text": "我、我只是提醒你！不勤劳、不守规矩的哥布林，要是背负了不敬畏格里芬的罪孽，可是会消失的！",
          "next": "line_15"
        },
        "line_15": {
          "speaker": "主角",
          "text": "消失？",
          "next": "line_16"
        },
        "line_16": {
          "speaker": "胖哥布林",
          "text": "对！就是消失！你知道吗？前几天我听说，军营里有个老混子哥布林失踪了！据说地上还留下了几片大羽毛……",
          "next": "line_17"
        },
        "line_17": {
          "speaker": "主角",
          "text": "……真的假的？",
          "next": "line_18"
        },
        "line_18": {
          "speaker": "主角·内心",
          "text": "怎么还有随机伤人事件？！那哥布林是被吃了吗？",
          "next": "line_19"
        },
        "line_19": {
          "speaker": "胖哥布林",
          "text": "不过你也不用太担心！伟大的格里芬虽然令人恐惧，但它只会惩戒不守规矩的家伙！",
          "next": "line_20"
        },
        "line_20": {
          "speaker": "胖哥布林",
          "text": "像我就不一样了！我可是很守规矩的！就是……就是能吃了点。格里芬肯定不会惩罚我的！",
          "next": "line_21"
        },
        "line_21": {
          "speaker": "主角",
          "text": "……嗯嗯，它肯定不会惩罚你的。",
          "next": "line_22"
        },
        "line_22": {
          "speaker": "主角·内心",
          "text": "明明怕得要死，还非得嘴硬。",
          "next": "line_23"
        },
        "line_23": {
          "speaker": "胖哥布林",
          "text": "不过话说回来，你自己都是格里芬派来的，怎么能什么都不知道呢？",
          "next": "line_24"
        },
        "line_24": {
          "speaker": "主角",
          "text": "……",
          "next": "line_25",
          "portrait": "res://assets/characters/apron_man/player_neutral_portrait.png"
        },
        "line_25": {
          "speaker": "胖哥布林",
          "text": "嘿嘿，难道你有什么事情瞒着我？",
          "next": "line_26"
        },
        "line_26": {
          "speaker": "主角",
          "text": "我不是说了嘛，刚来，对这里还不熟悉。",
          "next": "line_27"
        },
        "line_27": {
          "speaker": "胖哥布林",
          "text": "哈哈哈！别紧张，我开玩笑的！",
          "next": "line_28"
        },
        "line_28": {
          "speaker": "胖哥布林",
          "text": "不过啊，伟大的格里芬之所以伟大，可不只是因为它会惩罚坏家伙！",
          "next": "line_29"
        },
        "line_29": {
          "speaker": "主角",
          "text": "哦？那还有什么？",
          "next": ""
        }
      }
    },
    "day1.s04.griffin_blood": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "胖哥布林",
          "text": "嘿嘿！你终于问到重点了！伟大的格里芬之所以伟大，就是因为它会用自己的血哺育我们！",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "主角",
          "text": "血还能哺育你们？",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "胖哥布林",
          "text": "那当然！格里芬之血可是珍贵的圣物！据说里面蕴含着格里芬的力量，能赐予我们智慧，让我们挣好多好多金币！",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "胖哥布林",
          "text": "不仅如此！有了格里芬的庇护，赌博就能赢个盆满钵满，晚上睡觉也能安安稳稳，绝对不会被抓走！",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "主角·内心",
          "text": "……这都快把格里芬说成万能许愿机了。",
          "next": "line_6"
        },
        "line_6": {
          "speaker": "主角",
          "text": "这么厉害？那你喝过？",
          "next": "line_7"
        },
        "line_7": {
          "speaker": "胖哥布林",
          "text": "呃……这个嘛，格里芬之血可不是随随便便就能喝到的！那是圣物，平时由长老亲自保管，只有特殊的时候才能得到！",
          "next": "line_8"
        },
        "line_8": {
          "speaker": "主角",
          "text": "既然这么珍贵，你就不想尝尝？",
          "next": "line_9"
        },
        "line_9": {
          "speaker": "胖哥布林",
          "text": "想啊！我做梦都想！你想想，要是喝上一口，说不定以后每次赌博都能赢！到时候金币还不是哗啦啦地往口袋里流？把你奶茶店里每种奶茶都喝一遍，也不在话下！",
          "next": "line_10"
        },
        "line_10": {
          "speaker": "主角·内心",
          "text": "好家伙，前面还说格里芬会赐予智慧，结果这家伙满脑子还是金币、赌博和吃东西。",
          "next": "line_11"
        },
        "line_11": {
          "speaker": "主角",
          "text": "既然你这么想要，为什么不自己去找长老要？",
          "next": "line_12"
        },
        "line_12": {
          "speaker": "胖哥布林",
          "text": "你以为我不想吗？格里芬之血可是长老亲自保管的！不过，嘿嘿，今天倒是有个好机会。长老要亲自去祭拜伟大的格里芬，整晚都不会回来，宅邸今天是空的！",
          "next": "line_13"
        },
        "line_13": {
          "speaker": "主角",
          "text": "所以呢？",
          "next": "line_14"
        },
        "line_14": {
          "speaker": "胖哥布林",
          "text": "趁这个时候进去，说不定就能弄到一点格里芬之血！",
          "next": "line_15"
        },
        "line_15": {
          "speaker": "主角",
          "text": "……你让我去偷长老的东西？",
          "next": "line_16"
        },
        "line_16": {
          "speaker": "胖哥布林",
          "text": "哎呀，别说得那么难听嘛！而且你是格里芬使者，跟我们不一样！这两天比较特殊，我们这些普通哥布林要是靠近宅邸，说不定就会被伟大的格里芬察觉。可你说不定能悄悄进去！",
          "next": "line_17"
        },
        "line_17": {
          "speaker": "主角",
          "text": "你他妈不是很敬畏格里芬吗？怎么还要偷东西？",
          "next": "line_18"
        },
        "line_18": {
          "speaker": "胖哥布林",
          "text": "我当然敬畏啊！我就是想尝尝嘛！再说了，这么稀罕的东西，要是能拿来做成奶茶，肯定能卖得很好！只要你帮我弄到手，以后我每天都来买你的奶茶！",
          "next": "line_19"
        },
        "line_19": {
          "speaker": "主角·内心",
          "text": "每天都来买奶茶……格里芬之血听起来又确实是个稀罕玩意，要是能做成特调，说不定真能赚一笔。",
          "next": "line_20"
        },
        "line_20": {
          "speaker": "主角·内心",
          "text": "可是，偷了长老的东西，被发现了怎么办？……但我现在都快穷疯了！要钱没钱，要命……命倒是还有一条。",
          "next": "line_21"
        },
        "line_21": {
          "speaker": "主角·内心",
          "text": "不行！还是不敢啊！！",
          "next": ""
        }
      }
    },
    "day1.s04.map_handover": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "胖哥布林",
          "text": "对了，给你这个！你刚来这里，肯定还不熟悉路。",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "主角",
          "text": "你连地图都准备好了？",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "胖哥布林",
          "text": "那当然！上面标了主要的地方。长老的房间在洞穴深处，具体怎么进去，你得自己找找了。",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "主角",
          "text": "……你还真是把麻烦都安排给我了。",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "胖哥布林",
          "text": "哈哈哈！能者多劳嘛！",
          "next": "line_6"
        },
        "line_6": {
          "speaker": "系统",
          "text": "获得哥布林洞穴地图，地图功能已解锁。",
          "next": "line_7"
        },
        "line_7": {
          "speaker": "主角·内心",
          "text": "长老今晚不在，地图也有了。风险肯定有，但要是能弄到这种稀有材料，说不定真能赚上一笔。",
          "next": "line_8"
        },
        "line_8": {
          "speaker": "主角·内心",
          "text": "我现在可没资格嫌钱来得麻烦。只要不是毫无胜算，倒是值得试试。",
          "next": ""
        }
      }
    },
    "day1.s04.commission_choice_accept": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角",
          "text": "行，我去看看。但能不能拿到，我可不保证。",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "胖哥布林",
          "text": "好！我就知道你是个爽快人！",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "主角",
          "text": "先说好，真出了什么事，我可不会替你背锅。",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "胖哥布林",
          "text": "放心放心！愿格里芬垂顾你！",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "主角·内心",
          "text": "但愿这趟真能值回票价。",
          "next": ""
        }
      }
    },
    "day1.s04.commission_choice_refuse": {
      "start": "line_1",
      "lines": {
        "line_1": {
          "speaker": "主角",
          "text": "不行，风险太大，我不干。",
          "next": "line_2"
        },
        "line_2": {
          "speaker": "胖哥布林",
          "text": "哎呀，别急着拒绝嘛！你不是正缺钱吗？这么稀罕的东西，可不是天天都有机会碰上的！",
          "next": "line_3"
        },
        "line_3": {
          "speaker": "主角",
          "text": "你倒是挺会挑时候说话。",
          "next": "line_4"
        },
        "line_4": {
          "speaker": "胖哥布林",
          "text": "长老今晚又不在，你有地图，至少知道该往哪儿找。进去看看而已，说不定很快就能回来呢？",
          "next": "line_5"
        },
        "line_5": {
          "speaker": "主角·内心",
          "text": "长老不在，地图也有了。风险不小，但也不是完全没机会。",
          "next": "line_6"
        },
        "line_6": {
          "speaker": "主角·内心",
          "text": "我现在最缺的就是钱。要是能弄到这种稀有材料，或许就能赚上一笔……",
          "next": "line_7"
        },
        "line_7": {
          "speaker": "主角",
          "text": "……好吧，我去看看。但要是出了什么事，你也别想装作什么都不知道。",
          "next": "line_8"
        },
        "line_8": {
          "speaker": "胖哥布林",
          "text": "哈哈哈！我等你的好消息！愿格里芬垂顾你！",
          "next": "line_9"
        },
        "line_9": {
          "speaker": "主角",
          "text": "……最好真有好消息。",
          "next": ""
        }
      }
    },
