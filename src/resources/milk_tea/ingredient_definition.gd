class_name IngredientDefinition
extends Resource
## Static catalog data only. Discovery and quantities live in WarehouseInventory.

const TASTE_KEYS: PackedStringArray = ["sweetness", "sourness", "bitterness", "spiciness", "milkiness", "booziness"]
const BASE_SUFFIXES: PackedStringArray = ["奶茶", "茶", "咖啡", "特调"]

@export var id: String = ""
@export var display_name: String = ""
@export var icon: Texture2D
@export_enum("human", "otherworld") var origin: String = "human"
@export_enum("tea", "milk", "syrup", "topping", "product", "material", "story_item") var category: String = "tea"
@export var rarity: String = "普通"
@export var flavor_tags: PackedStringArray = []
@export var combat_attributes: PackedStringArray = []
@export var special_effects: PackedStringArray = []
@export var acquisition_sources: PackedStringArray = []
## Design source rows this entry came from, e.g. ["F05", "W02"] when two
## spreadsheet rows describe the same item. Keeps the catalog traceable.
@export var source_ids: PackedStringArray = []
## Spreadsheet 形态 column; empty for the teaching catalog.
@export var form: String = ""
## Spreadsheet 支持加工方式 column; empty for the teaching catalog.
@export var processing_methods: PackedStringArray = []
## Spreadsheet 标价（G）column; 0 means no public price.
@export var price: int = 0
## Spreadsheet 图鉴描述 column, shown only once the item is discovered.
@export_multiline var description: String = ""

@export_group("Recipe")
## Generated by tools/milk_tea/import_recipe_ingredients.py from the 2026-10-18
## ingredient sheet. Items outside that sheet keep these defaults and never enter
## free-form recipes.
## 原料图鉴是否收录。调饮基底（奶茶底、茶汤这类半成品）可以调饮却不算原料，
## 玩家在自由实验里直接选用即可，不需要一条图鉴条目。
@export var show_in_encyclopedia := true
## Eligibility for the first slot only; eligible bases may also fill additive slots.
@export var can_be_base := false
## One of BASE_SUFFIXES when can_be_base; appended to generated drink names.
@export var base_suffix: String = ""
## 普通配方可用. Required in every ordinary slot, independently of can_be_base.
## F09 is a base yet story-only; ordinary bases can also be additives.
@export var free_recipe_allowed := false
@export_range(0, 99) var sweetness := 0
@export_range(0, 99) var sourness := 0
@export_range(0, 99) var bitterness := 0
@export_range(0, 99) var spiciness := 0
@export_range(0, 99) var milkiness := 0
@export_range(0, 99) var booziness := 0
## Short tags merged and deduplicated per drink, unlike the descriptive flavor_tags.
@export var recipe_flavors: PackedStringArray = []
@export var recipe_textures: PackedStringArray = []
@export var recipe_effects: PackedStringArray = []

@export_group("Economy")
## 市场价格 per portion; -1 means the sheet leaves it blank (never read as free).
@export var market_price: int = -1
## 可使用次数: recipe steps each consume one use; deliveries and throws take whole portions.
@export_range(1, 99) var uses_per_portion := 1
## 稀有度档位 T1-T5 from the 2026-10-19 sheet; 0 means "not a traded ingredient".
## Never inferred from the display-only `rarity` string.
@export_range(0, 5) var economy_tier: int = 0
## trade: ordinary purchase, free formula and sale.
## quest: story-only (F09); no ordinary purchase, free formula or later sale.
## none: products, coins and teaching-only entries.
@export_enum("none", "trade", "quest") var economy_scope: String = "none"

@export_group("Throw")
## Key into ThrowTuning effects or modifiers; empty means no throw behaviour.
@export var throw_kind: String = ""

func get_taste() -> Dictionary:
	var taste := {}
	for key: String in TASTE_KEYS:
		taste[key] = int(get(key))
	return taste
