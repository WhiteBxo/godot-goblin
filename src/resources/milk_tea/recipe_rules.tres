signatures = Array[Dictionary]([
  {
    "id": "S01",
    "name": "苦工嚼力冰茶",
    "ingredients": [
      "industrial_green_tea",
      "red_mottled_wood",
      "cocoa_powder"
    ],
    "iced": true,
    "price": 12,
    "first_reward": 150,
    "appearance": "黄绿色的茶汤清透微浑，表面浮着一层可可粉。一根暗红色的咬木斜插在饮品中，末端浸入茶汤，木质表面吸饱茶汁后颜色更深。",
    "tasting_note": "茶汤清透微涩，入口带着淡淡的可可苦味。咬到整根红斑咬木时，木料坚韧耐嚼，苦、咸、甜与辛辣交织，咀嚼间逐渐透出浓重的木质气息。",
    "discovery_flow": "",
    "discovery_note": "",
