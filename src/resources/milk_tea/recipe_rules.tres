    ],
    "textures": [
      "清透",
      "坚韧耐嚼",
      "粉感"
    ],
    "effects": [
      "强烈清凉感"
    ]
  },
  {
    "id": "S02",
    "name": "黑糖窟窟厚奶",
    "ingredients": [
      "creamer_milk_tea_base",
      "sugar_yam",
      "brown_sugar_boba"
    ],
    "iced": false,
    "price": 8,
    "first_reward": 150,
    "appearance": "奶茶呈浓厚的乳黄色，紫灰色的糖芋泥半浮在液面，黑糖珍珠沉在底部，表面裹着一层深褐色的糖浆。整体色泽厚重。",
    "tasting_note": "奶茶底浓稠丝滑，黑糖的甜香十分突出。软糯的糖芋裹着弹韧黏稠的黑糖珍珠，下咽时厚实饱满，甜味在口中久久不散。",
    "discovery_flow": "",
    "discovery_note": "",
    "discovery_kind": "experiment",
    "flavors": [
      "奶香",
      "甜味",
      "黑糖香"
    ],
    "textures": [
      "浓稠",
      "丝滑",
      "软糯",
      "弹韧",
      "黏稠"
    ],
    "effects": []
  },
  {
    "id": "S03",
    "name": "焦脆爆裂黑咖",
    "ingredients": [
      "instant_coffee_concentrate",
      "scorch_tongue_pepper",
      "mint_choc_crisp"
    ],
    "iced": true,
    "price": 25,
    "first_reward": 150,
    "appearance": "浓黑的咖啡表面散落着深红色的炽舌椒碎片与深褐色的薄荷巧脆碎。细小的颗粒点缀在液面，深浅交错，在黑色咖啡的映衬下格外醒目。",
    "tasting_note": "咖啡入口焦苦，带着微酸的涩感。薄荷巧脆碎在齿间酥脆作响，随后炽舌椒的辛辣与烟熏气息猛然涌出，强烈的刺激感在口中层层叠加。",
    "discovery_flow": "",
    "discovery_note": "",
    "discovery_kind": "experiment",
    "flavors": [
      "咖啡香",
      "苦味",
      "酸味",
      "辛辣",
      "烟熏味",
      "可可香",
      "薄荷"
    ],
    "textures": [
      "坚韧耐嚼",
      "颗粒感",
      "酥脆"
    ],
    "effects": [
