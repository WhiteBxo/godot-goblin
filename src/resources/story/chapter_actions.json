  "market_vendors": [
    {
      "actor": "market_vendor_1",
      "title": "吆喝的摊主",
      "products": [
        {
          "id": "market_scorch_tongue_pepper",
          "pitch": "哎！客人，看看这个！炽舌椒！烟熏味浓，嚼起来又有劲！拿来做吃的，绝对够味！买点回去试试，保准不亏！"
        },
        {
          "id": "market_honey_amber_crystal",
          "pitch": "嘿嘿，这个可就厉害了！蜜珀晶，甜滋滋的，里面还带着颗粒！咬下去嘎吱嘎吱的，多有意思！不管你打算怎么做，都值得试试！"
        },
        {
          "id": "market_firefly_cap",
          "pitch": "瞧瞧这伞面，多漂亮！这可是萤火伞！味道甜，口感还滑溜溜的。要我说啊，这种好东西就该拿来做点精细的吃食！客人，来一点？"
        }
      ]
    },
    {
      "actor": "market_vendor_2",
      "title": "懂行的摊主",
      "products": [
        {
          "id": "market_moss_green",
          "pitch": "苔痕青。酸味重，还带点发酵的味道，质地也稠。口味比较特别，没试过就别一次买太多。不过，要是做对了，倒也不赖。"
        },
        {
          "id": "market_sugar_yam",
          "pitch": "窟窟糖芋，甜口的，软糯又顺滑。喜欢甜食的不会讨厌它。这个价钱买不了吃亏，买回去慢慢琢磨吧。"
        },
        {
          "id": "market_insomnia_mushroom",
          "pitch": "醒神菇。苦，草木味也重，不过汁水足。别光听名字就觉得它没用，怎么处理才是关键。你要是真会做，买回去研究研究。"
        }
      ]
    },
    {
      "actor": "market_vendor_3",
      "title": "老练的摊主",
      "products": [
        {
          "id": "market_scorch_tongue_pepper",
          "pitch": "炽石枯辛辣……闻见那股烟熏味了吗？越是耐嚼的东西，越值得花时间琢磨。买回去吧，说不定能做出些意想不到的东西。"
        },
        {
          "id": "market_honey_amber_crystal",
          "pitch": "蜜珀晶。甜味藏在那些小颗粒里，嚼开了才有意思。你要是只想喝点普通的东西，那可就浪费它了。"
        },
        {
          "id": "market_insomnia_mushroom",
          "pitch": "醒神菇……苦味、草木气，还有满满的汁水。有人嫌它难吃，有人却离不开它。至于你能拿它做出什么，就看你的本事了。"
        }
      ]
    }
  ]
