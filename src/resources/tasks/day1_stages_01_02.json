{
  "version": 1,
  "tasks": [
    {
      "id": "day1.order_human",
      "type": "main",
      "title": "珍珠奶茶 → 人类顾客",
      "description": "查看订单板接单，在制作台制作后交给指定顾客。",
      "reveal_when": {
        "type": "flag",
        "key": "day1.human_open"
      },
      "activate_when": {
        "type": "flag",
        "key": "day1.human_open"
      },
      "complete_when": {
        "type": "flag",
        "key": "day1.human_settled"
      },
      "objectives": [
        {
          "id": "view",
          "text": "查看订单并接单",
          "complete_when": {
            "type": "flag",
            "key": "task.day1.human.active"
          }
        },
        {
          "id": "make",
          "text": "制作珍珠奶茶",
          "complete_when": {
            "type": "variable_at_least",
            "key": "shop.drinks_made",
            "value": 1
          }
        },
        {
          "id": "deliver",
          "text": "交付并收款",
          "complete_when": {
            "type": "flag",
            "key": "day1.human_settled"
          }
        }
      ],
      "delivery": {
        "order_id": "day1_human",
        "product_id": "pearl_milk_tea",
        "target_object_id": "human_customer",
        "accepted_flag": "task.day1.human.active"
      },
      "rewards": {
        "text": "营业收入 10",
        "money": 10
      }
    },
