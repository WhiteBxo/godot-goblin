      ],
      "delivery": {
        "order_id": "order_insomnia_01",
        "items": {
          "insomnia_mushroom": 3
        },
        "target_object_id": "tavern"
      },
      "rewards": {
        "text": "糖浆 × 2（占位）",
        "items": {
          "syrup": 2
        }
