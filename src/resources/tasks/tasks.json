      },
      "rewards": {
        "text": "糖浆 × 1",
        "items": {
          "syrup": 1
        }
      }
    },
    {
      "id": "tavern.insomnia_order",
      "type": "commission",
      "title": "酒馆的醒神菇委托",
      "description": "酒馆人物想要三朵醒神菇。夜里到聚落各处的夜光菌丛采集，再回来交付。",
      "reveal_when": {
        "type": "flag",
        "key": "world.phase.night"
      },
      "activate_when": {
        "type": "flag",
        "key": "task.tavern.insomnia.active"
      },
      "complete_when": {
        "type": "flag",
        "key": "tavern.insomnia.delivered"
      },
      "objectives": [
        {
          "id": "gather_mushrooms",
