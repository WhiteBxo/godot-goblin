extends SceneTree

const StateData = preload("res://src/core/game_state.gd")
var checks := 0
var failures: Array[String] = []

func _initialize() -> void:
	_run.call_deferred()

func check(value: bool, description: String) -> void:
	checks += 1
	if not value:
		failures.append(description)
		push_error(description)

func frames(count: int = 3) -> void:
	for index in range(count):
		await process_frame

func click(control: Control) -> void:
	var event := InputEventMouseButton.new()
	event.button_index = MOUSE_BUTTON_LEFT
	event.position = control.get_global_rect().get_center()
	event.pressed = true
	root.push_input(event, true)
	event = event.duplicate()
	event.pressed = false
	root.push_input(event, true)
	await frames()

func capture(name: String) -> void:
	if "--capture" not in OS.get_cmdline_user_args() or DisplayServer.get_name() == "headless":
		return
	await frames()
	await RenderingServer.frame_post_draw
	DirAccess.make_dir_recursive_absolute("res://.godot/handbook")
	root.get_texture().get_image().save_png("res://.godot/handbook/" + name + ".png")

func _run() -> void:
	ProjectSettings.set_setting("debug/developer_tools/enabled", false)
	var state: StateData = root.get_node("GameState")
	state.reset_state()
	var game: MainGame = load("res://src/debug/story/legacy_shop.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await frames()
	var ui := game.get_ui_manager()
	var hud: HandbookHUD = game.get_node("HudLayer/HandbookHUD")
	var book: HandbookPanel = game.get_node("PopupLayer/HandbookPanel")
	var pages: TabContainer = book.get_pages()
	var chronicle: ChroniclePanel = book.get_chronicle_page()
	var shell: ModalShell = book.get_shell()
	var journal := game.get_chronicle_journal()
	var dot: Label = hud.get_node("Unread")
	var player := game.get_player() as PlayerController
	check(shell.get_close_button() != null and shell.find_children("*", "ColorRect", true, false).is_empty(), "Shared shell owns the close button and has no duplicate Dim")
	check(book.get_tasks_page().get_parent() == pages and chronicle.get_parent() == pages, "Pages live in the shared tab body")
	check(not book.get_tasks_page().has_node("Dim") and not chronicle.has_node("Margin/Panel"), "Content pages own no modal chrome")
	check(not hud.visible and hud.focus_mode == Control.FOCUS_NONE, "Both locked: no HUD or keyboard focus")
	check(game.open_tasks() == ERR_UNAVAILABLE and game.open_chronicle() == ERR_UNAVAILABLE, "Public entrypoints reject locked systems")
	check(ui.open_screen(&"tasks") == ERR_UNAVAILABLE and not ui.has_modal(), "Locked alias cannot reserve a modal")
	check(pages.is_tab_hidden(0) and pages.is_tab_hidden(1), "Locked pages are completely hidden")
	check(ui.register_screen_alias(&"tasks", &"handbook", book.select_page.bind(&"tasks")) == ERR_ALREADY_EXISTS, "Duplicate alias rejected")
	check(ui.register_screen_alias(&"bad", &"missing", book.select_page.bind(&"tasks")) == ERR_INVALID_PARAMETER, "Alias requires a registered canonical target")
	journal.unlock_entry("test.book", "一条很长的异闻录标题：聚落的秘密与旅途中记录的陌生见闻")
	journal.append_record("test.book", "test.long", "长篇见闻正文，用来检查自动换行与详情滚动。\n".repeat(30))
	check(hud.visible and dot.visible and pages.is_tab_hidden(0) and not pages.is_tab_hidden(1), "Chronicle-only unlock reveals a single page and unread dot")
	await click(hud)
	check(ui.is_open(&"handbook") and pages.current_tab == 1 and not player.movement_enabled, "Mouse click opens the only available page and locks movement")
	check(journal.get_unread_count() == 1, "Opening the shared shell never marks a record read")
	var list: ItemList = chronicle.get_entries()
	list.item_selected.emit(0)
	check(journal.get_unread_count() == 0 and not dot.visible, "Selecting an entry clears the unread dot")
	await capture("chronicle_only_640")
	ui.close_screen(&"chronicle")
	check(not ui.is_open(&"handbook") and player.movement_enabled, "Closing an alias closes the canonical modal")
	check(not list.is_anything_selected(), "Closing shared shell clears chronicle selection")
	state.reset_state()
	state.set_flag("task.shop.first_order.active")
	check(state.get_flag("ui.handbook.tasks_unlocked") and hud.visible, "First visible task permanently unlocks the handbook")
	check(not pages.is_tab_hidden(0) and pages.is_tab_hidden(1), "Task-only unlock hides chronicle")
	check(game.open_handbook() == OK and pages.current_tab == 0, "Task-only icon opens commissions")
	ui.close_screen(&"handbook")
	state.set_flag("task.shop.first_order.active", false)
	check(game.get_task_journal().get_active_tasks().is_empty() and hud.visible, "Empty task list retains an unlocked entry")
	check(game.open_tasks() == OK, "Unlocked empty task page is accessible")
	ui.close_screen(&"tasks")
	journal.unlock_entry("test.both", "异闻录")
	check(not pages.is_tab_hidden(0) and not pages.is_tab_hidden(1), "Both unlocked pages are available")
	var modal_changes: Array[bool] = []
	ui.modal_changed.connect(func() -> void: modal_changes.append(true))
	check(game.open_tasks() == OK, "Explicit task entry opens tasks")
	var transitions := modal_changes.size()
	check(game.open_chronicle() == OK and pages.current_tab == 1, "Chronicle entry switches the existing shell")
	check(modal_changes.size() == transitions and not player.movement_enabled, "Switching tabs never releases or reacquires the modal lock")
	check(ui.is_open(&"tasks") and ui.is_open(&"chronicle") and ui.is_open(&"handbook"), "Alias queries share one canonical open state")
	check(ui.open_screen(&"tasks") == OK and pages.current_tab == 0, "Direct alias opens its corresponding page")
	game.open_chronicle()
	ui.close_screen(&"handbook")
	game.open_handbook()
	check(pages.current_tab == 1 and journal.get_unread_count() == 1, "Icon remembers last tab without consuming unread records")
	ui.set_paused(true)
	check(game.open_tasks() == ERR_BUSY and ui.open_screen(&"tasks") == ERR_BUSY, "Pause blocks public and alias page switching")
	check(not book.can_process(), "Pause covers and freezes the shared window")
	journal.append_record("test.both", "test.covered", "暂停期间追加")
	check(journal.get_unread_count() == 1, "Covered page cannot consume unread content")
	ui.set_paused(false)
	check(ui.is_open(&"handbook") and not player.movement_enabled, "Resume restores the same modal and player lock")
	ui.close_screen(&"handbook")
	hud.grab_focus()
	game.open_handbook()
	ui.close_screen(&"handbook")
	check(root.gui_get_focus_owner() == hud and player.movement_enabled, "Closing restores focus to the handbook icon and movement")
	var saved := state.to_dict()
	game.free()
	await frames()
	game = load("res://src/core/settlement.tscn").instantiate()
	root.add_child(game)
	current_scene = game
	await frames()
	check(game.get_node("HudLayer/HandbookHUD").visible and state.to_dict() == saved, "Host rebuild preserves access without rewriting saved state")
	state.reset_state()
	check(not game.get_node("HudLayer/HandbookHUD").visible, "New game reset hides the rebuilt HUD")
	state.set_flag("task.shop.first_order.active")
	state.set_flag("shop.order_001_delivered")
	state.set_flag("ui.handbook.tasks_unlocked", false)
	check(state.get_flag("ui.handbook.tasks_unlocked"), "Completed task history migrates legacy unlock state")
	var legacy := state.to_dict()
	legacy.flags.erase("ui.handbook.tasks_unlocked")
	state.reset_state()
	state.restore_state(legacy)
	await frames()
	check(state.get_flag("ui.handbook.tasks_unlocked"), "Legacy restore defers unlock persistence until GameState finishes committing")
	journal = game.get_chronicle_journal()
	journal.unlock_entry("test.settlement", "聚落见闻")
	journal.append_record("test.settlement", "test.settlement_long", "长篇见闻正文，用来检查自动换行与详情滚动。\n".repeat(30))
	game.open_chronicle()
	await capture("settlement_chronicle_640")
	game.get_node("PopupLayer/HandbookPanel").get_chronicle_page().get_entries().item_selected.emit(0)
	root.size = Vector2i(1280, 720)
	await capture("settlement_chronicle_1280")
	game.get_ui_manager().close_screen(&"handbook")
	await capture("settlement_hud_1280")
	game.free()
	await frames()
	state.reset_state()
	root.size = Vector2i(640, 360)
	game = load("res://src/core/main.tscn").instantiate()
	game.day1_story_enabled = true
	root.add_child(game)
	current_scene = game
	await frames()
	game.get_story_director().cancel_event("Handbook access validation")
	state.set_flag("day1.human_open")
	var day_hud: HandbookHUD = game.get_node("HudLayer/HandbookHUD")
	var day_book: HandbookPanel = game.get_node("PopupLayer/HandbookPanel")
	var day_pages: TabContainer = day_book.get_pages()
	check(day_hud.visible and day_pages.is_tab_hidden(1), "Day 1 first order unlocks tasks before chronicle")
	game.get_chronicle_journal().unlock_entry("test.day1", "剧情条目")
	check(day_pages.is_tab_hidden(1) and game.open_chronicle() == ERR_UNAVAILABLE, "Day 1 entries cannot bypass the story system gate")
	state.set_flag("day1.chronicle_unlocked")
	check(not day_pages.is_tab_hidden(1) and day_hud.get_node("Unread").visible, "Day 1 story flag reveals chronicle and its unread dot")
	await capture("day1_hud_640")
	game.open_tasks()
	await capture("day1_tasks_640")
	root.size = Vector2i(1280, 720)
	await capture("day1_tasks_1280")
	game.get_ui_manager().close_screen(&"handbook")
	var alias_ui := game.get_ui_manager()
	var scratch := Control.new()
	check(alias_ui.register_screen(&"scratch", scratch, &"popup", true) == OK, "Register temporary canonical screen")
	check(alias_ui.register_screen_alias(&"scratch_alias", &"scratch", func() -> Error: return OK) == OK, "Register temporary alias")
	alias_ui.unregister_screen(&"scratch_alias")
	check(alias_ui.open_screen(&"scratch_alias") == ERR_DOES_NOT_EXIST and alias_ui.open_screen(&"scratch") == OK, "Removing alias leaves canonical screen available")
	alias_ui.close_screen(&"scratch")
	alias_ui.register_screen_alias(&"scratch_alias", &"scratch", func() -> Error: return OK)
	scratch.free()
	check(alias_ui.open_screen(&"scratch_alias") == ERR_DOES_NOT_EXIST, "Freeing canonical view clears aliases")
	check(alias_ui.register_screen(&"scratch_alias", Control.new(), &"popup", true) == OK, "Freed aliases no longer reserve IDs")
	game.free()
	await frames()
	state.reset_state()
	print("HANDBOOK: %d checks; %d failures" % [checks, failures.size()])
	quit(0 if failures.is_empty() else 1)
